"""MCU: STM32U083KCU6 (Cortex-M0+, 256 KB flash, 40 KB SRAM, UFQFPN32) and its support parts.

Runs directly from VBAT (1.71-3.6 V). Stop 2 is 750 nA typ at 3.0 V (DS14548
Table 40). LPTIM1-3 keep running in Stop 2, so LPTIM2 on PA8 can generate the
LCD EXTCOMIN clock without waking the CPU. Brown-out reset BOR1 falls at
2.00 V typ (1.96-2.04 V, Table 24).

Pin map (also docs/firmware-handoff.md):
  PA0  MUSIC_PRESENT  EXTI0 / WKUP1         PA8  LCD_EXTCOMIN LPTIM2_CH1 (AF14), TIM1_CH1 (AF1)
  PA1  ENV_OUT        ADC1_IN5 / COMP1_INP3 PA9  SPARE_1      USART1_TX / I2C1_SCL
  PA2  UART_TX        USART2_TX (AF7)       PA10 SPARE_2      USART1_RX / I2C1_SDA
  PA3  UART_RX        USART2_RX (AF7)       PA13 SWDIO
  PA4  LCD_DISP       GPIO                  PA14 SWCLK
  PA5  LCD_SCLK       SPI1_SCK (AF5)        PB0  AUDIO_RAW    ADC1_IN17 (Option B)
  PA6  LCD_CS         GPIO, active high     PB1  AUDIO_VMID   ADC1_IN18 / COMP1_INM2
  PA7  LCD_MOSI       SPI1_MOSI (AF5)       PB4/PB5/PB6  BTN_SELECT / BTN_DANCE_A / BTN_DANCE_B, EXTI4/5/6
"""

load("@stdlib/units.zen", "Capacitance")
load("@stdlib/utils.zen", "e12")

Mcu = Module("code.diode.computer/lena/registry/components/STMicroelectronics/STM32U083KCU6/STM32U083KCU6.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")
Crystal = Module("@stdlib/generics/Crystal.zen")

VBAT = io(Power(voltage="2.0V to 3.3V"))
GND = io(Ground)

LCD_SCLK = io(Net, help="PA5, SPI1_SCK.")
LCD_MOSI = io(Net, help="PA7, SPI1_MOSI.")
LCD_CS = io(Net, help="PA6, plain GPIO output; Sharp SCS is active high.")
LCD_DISP = io(Net, help="PA4, plain GPIO output.")
LCD_EXTCOMIN = io(Net, help="PA8, LPTIM2_CH1 (runs in Stop 2) or TIM1_CH1.")
BTN_SELECT = io(Net, help="PB4, input with internal pull-up, EXTI4.")
BTN_DANCE_A = io(Net, help="PB5, input with internal pull-up, EXTI5.")
BTN_DANCE_B = io(Net, help="PB6, input with internal pull-up, EXTI6.")
MUSIC_PRESENT = io(Net, help="PA0, EXTI0 and WKUP1 (wakes Stop 2, Standby and Shutdown).")
ENV_OUT = io(Net, help="PA1, ADC1_IN5; also COMP1_INP3.")
AUDIO_VMID = io(Net, help="PB1, ADC1_IN18; also COMP1_INM2.")
AUDIO_RAW = io(Net, help="PB0, ADC1_IN17 (Option B direct sampling).")
UART_TX = io(Net, help="PA2, USART2_TX or LPUART1_TX.")
UART_RX = io(Net, help="PA3, USART2_RX or LPUART1_RX.")
SWDIO = io(Net, help="PA13.")
SWCLK = io(Net, help="PA14.")
NRST = io(Net, help="PF2-NRST, active-low reset.")
BOOT0 = io(Net, help="PF3-BOOT0, held low by R_BOOT0.")
SPARE_1 = io(Net, help="PA9, spare (USART1_TX / I2C1_SCL / TIM1_CH2).")
SPARE_2 = io(Net, help="PA10, spare (USART1_RX / I2C1_SDA / TIM1_CH3).")

lse_load_capacitance = config(
    Capacitance, default="7pF", help="Specified load capacitance CL of the 32.768 kHz crystal."
)
lse_stray_capacitance = config(Capacitance, default="3pF", help="Estimated pin plus trace capacitance per crystal pin.")


def lse_load_capacitor(c_load, c_stray):
    """Pierce oscillator load capacitors, ST AN2867: C1 = C2 = 2 * (CL - Cstray)."""
    return e12(Capacitance(2 * (c_load - c_stray)))


C_LSE = lse_load_capacitor(lse_load_capacitance, lse_stray_capacitance)

OSC32_IN = Net()
OSC32_OUT = Net()

Mcu(
    name="U_MCU",
    VDD=VBAT,
    VDDA=VBAT,
    GND=GND,
    NRST=NRST,
    BOOT0=BOOT0,
    PA0=MUSIC_PRESENT,
    PA1=ENV_OUT,
    PA2=UART_TX,
    PA3=UART_RX,
    PA4=LCD_DISP,
    PA5=LCD_SCLK,
    PA6=LCD_CS,
    PA7=LCD_MOSI,
    PA8=LCD_EXTCOMIN,
    PA9=SPARE_1,
    PA10=SPARE_2,
    PA11=NotConnected(),
    PA12=NotConnected(),
    PA13=SWDIO,
    PA14=SWCLK,
    PA15=NotConnected(),
    PB0=AUDIO_RAW,
    PB1=AUDIO_VMID,
    PB3=NotConnected(),
    PB4=BTN_SELECT,
    PB5=BTN_DANCE_A,
    PB6=BTN_DANCE_B,
    PB7=NotConnected(),
    PC14=OSC32_IN,
    PC15=OSC32_OUT,
)

# DS14463 Fig. 13: 100 nF per VDD pin plus 4.7 uF; 100 nF + 1 uF on VDDA/VREF+.
Capacitor(name="C_VDD1", value="100nF", package="0603", dielectric="X7R", P1=VBAT, P2=GND)
Capacitor(name="C_VDD17", value="100nF", package="0603", dielectric="X7R", P1=VBAT, P2=GND)
Capacitor(name="C_VDD_BULK", value="4.7uF", package="0603", dielectric="X7R", P1=VBAT, P2=GND)
Capacitor(name="C_VDDA", value="100nF", package="0603", dielectric="X7R", P1=VBAT, P2=GND)
Capacitor(name="C_VDDA_BULK", value="1uF", package="0603", dielectric="X7R", P1=VBAT, P2=GND)

# NRST has an internal pull-up; 100 nF filters the pinhole reset switch and ESD.
Capacitor(name="C_NRST", value="100nF", package="0603", dielectric="X7R", P1=NRST, P2=GND)

# Keeps BOOT0 low so the part boots from flash; pull it high via TP_BOOT0 for the ROM bootloader.
Resistor(name="R_BOOT0", value="10kOhm", package="0603", P1=BOOT0, P2=GND)

# 32.768 kHz LSE: CL = 7 pF, ESR 70 kOhm -> gm_crit ~0.8 uA/V, so LSEDRV medium-high (1.7 uA/V max).
Crystal(
    name="Y_LSE",
    package="3215_2Pin",
    frequency="32.768kHz",
    load_capacitance=lse_load_capacitance,
    esr="70kOhm",
    mpn="ABS07-32.768KHZ-7-T",
    manufacturer="Abracon LLC",
    XIN=OSC32_IN,
    XOUT=OSC32_OUT,
)
Capacitor(name="C_LSE_IN", value=C_LSE, package="0603", dielectric="C0G", P1=OSC32_IN, P2=GND)
Capacitor(name="C_LSE_OUT", value=C_LSE, package="0603", dielectric="C0G", P1=OSC32_OUT, P2=GND)
