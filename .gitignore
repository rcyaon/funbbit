# --- macOS ---
.DS_Store

# --- KiCad: backups, locks, caches, per-user state ---
*-backups/
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-bak
*~
_autosave-*
\#auto_saved_files#
~*.lck
*.lck
fp-info-cache
*.kicad_prl
# Generated by `pcb layout` / KiCad exports (regenerate, don't commit)
eda/default.net
eda/snapshot.layout.json
*.net
*.erc
*.drc
*.rpt

# --- Diode pcb ---
# stdlib/package cache (pcb fetches it; fp-lib-table points at ../.pcb/stdlib)
.pcb/
# vendor/ IS committed (pcb.toml vendors code.diode.computer/** for offline builds)

# --- Fab outputs: keep the curated ones in fab/, ignore scratch exports ---
gerbers/
*.gbr
*.drl
*.zip
!fab/**

# --- Simulation / Python ---
testbench/output/
*.cir
__pycache__/
*.pyc

# --- KiCad local history ---
**/.history/
